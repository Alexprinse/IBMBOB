    "request_raw": "Add promotional coupon support to checkout. Customers should be able to enter a coupon code at checkout and receive a percentage or fixed-amount discount on their order total.",
    "request_normalized": "Add coupon code support to the checkout flow with percentage and fixed-amount discount types.",
    "intended_behavior": [
      "Checkout endpoint accepts an optional coupon_code field",
      "A valid coupon reduces the order total by the configured discount amount",
      "An invalid or expired coupon returns a 400 error with a clear message",
      "The payment amount sent to the payment service is never negative",
      "Coupon usage is recorded so single-use coupons cannot be reused"
    ],
    "functional_requirements": [
      {
        "id": "req-01",
        "description": "Checkout endpoint accepts an optional coupon_code string in the request body",
        "priority": "must_have"
      },
      {
        "id": "req-02",
        "description": "A PERCENTAGE coupon reduces the total by (discount_percent / 100) * subtotal",
        "priority": "must_have"
      },
      {
        "id": "req-03",
        "description": "A FIXED coupon reduces the total by the fixed discount_amount",
        "priority": "must_have"
      },
      {
        "id": "req-04",
        "description": "An unknown coupon_code returns HTTP 400 with error detail 'coupon_not_found'",
        "priority": "must_have"
      },
      {
        "id": "req-05",
        "description": "An expired coupon (expires_at < now) returns HTTP 400 with error detail 'coupon_expired'",
        "priority": "must_have"
      },
      {
        "id": "req-06",
        "description": "A single-use coupon that has already been used returns HTTP 400 with error detail 'coupon_already_used'",
        "priority": "should_have"
      },
      {
        "id": "req-07",
        "description": "The response includes a discount_applied field showing the monetary discount",
        "priority": "should_have"
      }
    ],
    "invariants": [
      {
